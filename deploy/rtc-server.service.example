[Unit]
Description=C++ WebRTC signaling and DataChannel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webrtc
Group=webrtc
WorkingDirectory=/opt/webrtc-github-pages-cpp
ExecStart=/opt/webrtc-github-pages-cpp/build/rtc_server --bind 127.0.0.1 --port 8080 --allow-origin https://YOUR_GITHUB_USER.github.io
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
